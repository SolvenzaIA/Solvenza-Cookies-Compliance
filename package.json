{
  "name": "@solvenza/cookies-compliance",
  "version": "1.5.1",
  "description": "SDK minimalista, local-first y sin dependencias de gestión de consentimiento para España (LSSI art 22.2, AEPD, RGPD y LOPDGDD)",
  "type": "module",
  "main": "./dist/consent.esm.js",
  "module": "./dist/consent.esm.js",
  "types": "./dist/consent.esm.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolvenzaIA/Solvenza-Cookies-Compliance.git"
  },
  "bugs": {
    "url": "https://github.com/SolvenzaIA/Solvenza-Cookies-Compliance/issues"
  },
  "homepage": "https://github.com/SolvenzaIA/Solvenza-Cookies-Compliance#readme",
  "bin": {
    "consent-audit": "./bin/audit-cli.js",
    "consent-init": "./bin/init-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/consent.esm.d.ts",
      "import": "./dist/consent.esm.js",
      "require": "./dist/consent.esm.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js",
      "require": "./dist/audit.cjs"
    },
    "./react": {
      "types": "./dist/wrappers/react.d.ts",
      "import": "./dist/wrappers/react.js"
    },
    "./angular": {
      "types": "./dist/wrappers/angular.d.ts",
      "import": "./dist/wrappers/angular.js"
    },
    "./next": {
      "types": "./dist/wrappers/next.d.ts",
      "import": "./dist/wrappers/next.js"
    },
    "./vue": {
      "types": "./dist/wrappers/vue.d.ts",
      "import": "./dist/wrappers/vue.js"
    },
    "./nuxt": {
      "types": "./dist/wrappers/nuxt.d.ts",
      "import": "./dist/wrappers/nuxt.js"
    },
    "./wordpress": {
      "types": "./dist/wrappers/wordpress.d.ts",
      "import": "./dist/wrappers/wordpress.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "node playground/server.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "solvenza",
    "cookies",
    "compliance",
    "consent",
    "consent-sdk",
    "gdpr",
    "rgpd",
    "lssi",
    "aepd",
    "privacy",
    "local-first"
  ],
  "author": "Solvenza Team",
  "license": "MIT",
  "devDependencies": {
    "@angular/core": "^17.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "happy-dom": "^17.4.4",
    "react": "^19.2.8",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "vue": "^3.5.43"
  }
}
